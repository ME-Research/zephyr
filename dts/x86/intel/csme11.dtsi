 *
 * Intel CSME 11 (Sunrise Point PCH): the engine's view of its own address
 * space (csme-hardware-registers.md in the CSME reversing notes). Devices
 * behind ATT windows (the trace hub) are at the addresses the boot ROM maps
 * them to.
 */

#include <skeleton.dtsi>
#include <mem.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			compatible = "intel,lakemont", "intel,x86";
			reg = <0>;
			device_type = "cpu";
		};
	};

	intc_loapic: interrupt-controller@fee00000 {
		compatible = "intel,loapic";
		reg = <0xfee00000 0x1000>;
		interrupt-controller;
		#interrupt-cells = <3>;
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		/* Private bus 0:01.1: BAR0, BAR5, configuration space. The
		 * interrupt is an MSI; IRQ numbers above the local APIC's LVT
		 * lines (0-5) are message-signalled only.
		 */
		app_timer: timer@f00c8000 {
			compatible = "intel,csme-app-timer";
			reg = <0xf00c8000 0x1000>, <0xf00cd000 0x1000>, <0xf1009000 0x1000>;
			reg-names = "regs", "ctl", "cfg";
			interrupt-parent = <&intc_loapic>;
			interrupts = <16 0 2>;
			/* the counter rate is inferred, not confirmed */
			clock-frequency = <1000000000>;
		};

		/* An STH software channel of the trace hub (ATT window 3) */
		sth_console: trace@f7012040 {
			compatible = "intel,npk-sth";
			reg = <0xf7012040 0x40>;
		};
	};
};
